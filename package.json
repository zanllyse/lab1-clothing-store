{
  "name": "lab1-clothing-store-api",
  "version": "1.0.0",
  "description": "Навчальний REST API інтернет-магазину одягу на Node.js, Express та Prisma",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "nodemon": "3.1.9",
    "prisma": "6.8.2"
  },
  "allowScripts": {
    "@prisma/client@6.8.2": true,
    "prisma@6.8.2": true,
    "@prisma/engines@6.8.2": true
  }
}
